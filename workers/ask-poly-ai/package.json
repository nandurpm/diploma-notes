{
  "name": "ask-poly-ai-worker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node --check src/secure-index.js && node --check src/index.js",
    "check": "node --check src/index.js",
    "test": "node --test test/*.test.js test/*.test.mjs",
    "coverage": "node --test --experimental-test-coverage test/*.test.js test/*.test.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.147.0"
  }
}

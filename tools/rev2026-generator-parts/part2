BASE_JS = '\n(() => {\n  const qs=s=>document.querySelector(s), qsa=s=>[...document.querySelectorAll(s)];\n  const body=document.body;\n  const ua=navigator.userAgent||"";\n  if(window.ReactNativeWebView || /POLY.?PMNA/i.test(ua) || new URLSearchParams(location.search).get("app")==="1") body.classList.add("app-embed");\n  const progress=qs("#progressBar");\n  const updateProgress=()=>{const h=document.documentElement;const max=h.scrollHeight-h.clientHeight;progress.style.width=(max?Math.min(100,h.scrollTop/max*100):0)+"%";};\n  addEventListener("scroll",updateProgress,{passive:true});updateProgress();\n  qs("#themeBtn")?.addEventListener("click",()=>body.classList.toggle("dark"));\n  qs("#motionBtn")?.addEventListener("click",()=>body.classList.toggle("reduced"));\n  const expand=()=>qsa("details").forEach(d=>d.open=true);\n  const collapse=()=>qsa(".topic").forEach(d=>d.open=false);\n  qs("#expandBtn")?.addEventListener("click",expand);\n  qs("#collapseBtn")?.addEventListener("click",collapse);\n  const preparePrint=()=>{expand();body.classList.add("print-mode");qsa("svg .flow-dot,svg .pulse-dot").forEach(n=>n.style.animation="none");};\n  const doPrint=()=>{preparePrint();document.title="downloadable-notes-"+body.dataset.course;setTimeout(()=>window.print(),500);};\n  qsa("[data-print]").forEach(b=>b.addEventListener("click",doPrint));\n  addEventListener("afterprint",()=>body.classList.remove("print-mode"));\n  const search=qs("#lessonSearch");\n  search?.addEventListener("input",()=>{const term=search.value.trim().toLowerCase();qsa(".topic,.question-card,.formula-card,.practical-card").forEach(el=>{el.style.display=!term||el.textContent.toLowerCase().includes(term)?"":"none";});});\n  const auto=new URLSearchParams(location.search).get("autoPrintNotes")==="1";\n  if(auto){addEventListener("load",()=>setTimeout(doPrint,1000));}\n})();\n'

def html_list(items, cls=""):
    return f'<ul class="{cls}">' + ''.join(f'<li>{escape(str(x))}</li>' for x in items) + '</ul>'



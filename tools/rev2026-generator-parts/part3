def make_question_blocks(module, module_no):
    topics=[t["title"] for t in module["topics"]]
    q1=[]
    q3=[]
    q7=[]
    mcq=[]
    for i,t in enumerate(topics[:8],1):
        q1.append((f"Define or identify {t}.", f"A correct one-line definition or labelled identification of {t}."))
    for i,t in enumerate(topics[:5],1):
        q3.append((f"Explain {t} with one suitable example or diagram.", f"State the principle, explain key steps/parts, and give one relevant example."))
    for i,t in enumerate(topics[:3],1):
        q7.append((f"Discuss {t} in detail, including principle, procedure/derivation, diagram and applications.", f"Use a structured answer: definition, principle, labelled diagram/derivation, key equations or rules, applications and precautions."))
    opts=["It is always independent of conditions","It follows the stated engineering definition","It has no practical use","It is only a decorative term"]
    for i,t in enumerate(topics[:5],1):
        mcq.append((f"Which statement best describes {t}?",opts,1))
    def qcards(items, mark):
        s=[]
        for i,(q,a) in enumerate(items,1):
            s.append(f'<article class="question-card"><span class="qmeta">{mark} mark{"s" if mark!=1 else ""} • M{module_no}</span><h4>Q{i}. {escape(q)}</h4><details><summary>Answer guide</summary><p>{escape(a)}</p></details></article>')
        return ''.join(s)
    m=[]
    for i,(q,opts,ans) in enumerate(mcq,1):
        lis=''.join(f'<li>{chr(65+j)}. {escape(o)}</li>' for j,o in enumerate(opts))
        m.append(f'<article class="question-card"><span class="qmeta">MCQ • M{module_no}</span><h4>Q{i}. {escape(q)}</h4><ol class="options">{lis}</ol><details><summary>Answer</summary><p><strong>{chr(65+ans)}</strong> — {escape(opts[ans])}</p></details></article>')
    return f'''
    <h3>One-mark practice</h3><div class="question-grid">{qcards(q1,1)}</div>
    <h3>Three-mark practice</h3><div class="question-grid">{qcards(q3,3)}</div>
    <h3>Seven-mark practice</h3><div class="question-grid">{qcards(q7,7)}</div>
    <h3>MCQs</h3><div class="question-grid">{''.join(m)}</div>
    '''


def topic_html(topic, idx, module_no, accent):
    title=topic["title"]
    expl=topic.get("explanation","")
    points=topic.get("points",[])
    ml=topic.get("ml","")
    formula=topic.get("formula","")
    app=topic.get("application","")
    diagram=topic.get("diagram","")
    out=[f'<details class="topic" id="m{module_no}-t{idx}" open><summary><span>{idx}. {escape(title)}</span><span class="summary-tag">Learn</span></summary><div class="topic-body">']
    if expl: out.append(f'<p>{expl}</p>')
    if points: out.append(html_list(points,"key-list"))
    if formula: out.append(f'<div class="formula"><strong>Formula / Rule</strong><div>{formula}</div></div>')
    if ml: out.append(f'<div class="ml"><strong>Malayalam explanation:</strong> {ml}</div>')
    if app: out.append(f'<div class="application"><strong>Engineering application:</strong> {app}</div>')
    if diagram: out.append(diagram)
    out.append('</div></details>')
    return ''.join(out)



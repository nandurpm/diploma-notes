def fail(message):
    raise SystemExit(message)

payload = "".join((PAYLOAD_DIR / name).read_text().strip() for name in ("courses.part1","courses.part2"))
courses = json.loads(zlib.decompress(base64.b64decode(payload)).decode("utf-8"))
codes = ("1003","1008","1031","2031","2032")
LESSONS.mkdir(parents=True, exist_ok=True)

for code in codes:
    if code not in courses:
        fail(f"Missing course data: {code}")
    text = build_handbook(courses[code])
    required = [
        f'data-course="{code}"',
        f'<meta name="course-code" content="{code}">',
        "REV2026", "Malayalam", "Print / Save PDF", "autoPrintNotes",
        "Expected Questions", "Syllabus Coverage Checklist"
    ]
    missing = [item for item in required if item not in text]
    if missing:
        fail(f"{code} missing markers: {missing}")
    if text.count('class="module"') < 4:
        fail(f"{code} has fewer than four modules")
    if len(text.encode("utf-8")) < 50000:
        fail(f"{code} handbook is unexpectedly small")
    if any(host in text for host in ("cdn.jsdelivr.net","cdnjs.cloudflare.com","unpkg.com","fonts.googleapis.com")):
        fail(f"{code} uses a blocked external dependency")
    target = LESSONS / f"lessons-{code}.html"
    target.write_text(text, encoding="utf-8")
    print(f"Wrote {target.relative_to(ROOT)} ({target.stat().st_size:,} bytes)")

existing = LESSONS / "lessons-1002.html"
if not existing.exists() or existing.stat().st_size < 50000:
    fail("Existing REV2026 Course 1002 handbook is missing or incomplete; it was intentionally preserved.")

pages = list((ROOT / "revision-2026").glob("*.html"))
page_text = "\n".join(p.read_text(encoding="utf-8", errors="ignore") for p in pages)
required_cards = ("1002","1003","1008","1031","2031","2032")
missing_cards = [code for code in required_cards if f'data-subject-code="{code}"' not in page_text]
if missing_cards:
    print("Missing cards; rebuilding generated REV2026 pages:", ", ".join(missing_cards))
    subprocess.run([sys.executable, str(ROOT / "tools" / "build_revision_2026_pages.py")], cwd=ROOT, check=True)
    pages = list((ROOT / "revision-2026").glob("*.html"))
    page_text = "\n".join(p.read_text(encoding="utf-8", errors="ignore") for p in pages)
    still_missing = [code for code in required_cards if f'data-subject-code="{code}"' not in page_text]
    if still_missing:
        fail(f"Subject cards remain missing after rebuild: {still_missing}")
else:
    print("All six subject cards already exist; no duplicate cards created.")

print("Batch handbook generation and validation passed.")

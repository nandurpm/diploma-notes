{
  // Keep API keys as Cloudflare/GitHub secrets. Do not write them here.
  // Required Worker secrets:
  // - OPENAI_API_KEY
  // Optional chat fallback secrets:
  // - NVIDIA_API_KEY
  // - GEMINI_API_KEY
  // - GOOGLE_AI_STUDIO
  // Recommended provider order for Ask POLY chat:
  // AI_PROVIDER_ORDER = "openai,nvidia,gemini"
  // Optional model overrides:
  // OPENAI_MODEL = "gpt-4o-mini"
  // MOCK_EXAM_MODEL = "gpt-4o-mini"
  // NVIDIA_MODEL = "meta/llama-3.1-8b-instruct"
  // GEMINI_MODEL = "gemini-3.5-flash"
  // Optional safety/debug settings:
  // EXPOSE_ERRORS = "false"
  // MOCK_EXAM_REASONING_EFFORT = "low"
  // MOCK_EXAM_MAX_OUTPUT_TOKENS = "7500"
  // PROVIDER_TIMEOUT_MS = "7000"
  "name": "ask-poly-ai",
  "main": "workers/ask-poly-ai/src/index.js",
  "compatibility_date": "2026-06-29"
}
